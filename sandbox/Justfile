# Sandbox image name and tag
name := env("SANDBOX_NAME", "sandbox")
tag := env("SANDBOX_TAG", "latest")
image := name + ":" + tag

# Directory containing this Justfile
root := justfile_directory()

# Dockerfile path
dockerfile := root / "Dockerfile"

# Sibling `secret` Justfile (used by run-copilot to fetch GH_TOKEN)
secret_justfile := root / ".." / "secret" / "Justfile"

# Default CPUs and memory for the container
cpus := env("SANDBOX_CPUS", "4")
memory := env("SANDBOX_MEMORY", "4g")

# Builder CPUs and memory
builder_cpus := env("SANDBOX_BUILDER_CPUS", cpus)
builder_memory := env("SANDBOX_BUILDER_MEMORY", memory)

# GHCR settings
ghcr_name := env("GHCR_NAME", "")
ghcr_image := env("GHCR_IMAGE", if ghcr_name != "" { "ghcr.io/" + ghcr_name + "/" + name } else { "" })

# Tailscale state directory on host (persists across container runs)
ts_state := env("HOME") / ".tailscale-container"

# In-container mount points
mount := "/home/agent/pwd"
project_mount := "/home/agent/project"

# Shared `container run` flags
run_flags := "-it --rm --cpus " + cpus + " --memory " + memory

# GH_TOKEN passthrough (passes --env GH_TOKEN if set in host environment)
gh_token_flag := if env("GH_TOKEN", "") != "" { "--env GH_TOKEN" } else { "" }

# Tailscale auth-key passthrough: include --env and --authkey flags when TS_AUTHKEY is set
ts_authkey_env := if env("TS_AUTHKEY", "") != "" { "--env TS_AUTHKEY" } else { "" }
ts_authkey_flag := if env("TS_AUTHKEY", "") != "" { "--authkey=$TS_AUTHKEY" } else { "" }

# List available recipes (default)
default:
    @just --list

# --- System ---

# Start the Apple container system service
[group('system')]
system-start:
    container system start

# Stop the Apple container system service
[group('system')]
system-stop:
    container system stop

# (private) Ensure the Apple container system service is running; start it if not
[private]
_system-ensure:
    #!/usr/bin/env bash
    status="$(container system status 2>/dev/null | awk '$1=="status"{print $2}')"
    if [ "$status" != "running" ]; then
        echo "Apple container system not running; starting..."
        container system start
    fi

# --- Image ---

# Build the sandbox image (set no_cache="--no-cache" to build without cache)
[group('image')]
image-build *no_cache: _system-ensure
    container build {{no_cache}} --tag {{image}} --file {{dockerfile}} {{root}}

# Build with increased builder resources (for Homebrew-heavy images; pass --no-cache to skip cache)
[group('image')]
image-build-big *no_cache: _system-ensure
    -container builder stop
    -container builder delete
    container builder start --cpus {{builder_cpus}} --memory {{builder_memory}}
    container build {{no_cache}} --tag {{image}} --file {{dockerfile}} {{root}}

# List all images
[group('image')]
image-list: _system-ensure
    container image list

# Remove the local sandbox image
[group('image')]
image-clean: _system-ensure
    container image delete {{image}}

# Reset the builder (useful if builds are failing)
[group('image')]
image-reset-builder: _system-ensure
    -container builder stop
    -container builder delete

# --- GHCR ---

# (private) Ensure GHCR env vars are set
[private]
_ghcr-check:
    #!/usr/bin/env bash
    if [ -z "${GHCR_NAME:-}" ] && [ -z "${GHCR_IMAGE:-}" ]; then
        echo "Error: GHCR_NAME (or GHCR_IMAGE) must be set"
        exit 1
    fi

# Login to GitHub Container Registry
[group('ghcr')]
image-login: _system-ensure
    #!/usr/bin/env bash
    missing=""
    [ -z "${GHCR_NAME:-}" ] && missing="${missing} GHCR_NAME"
    [ -z "${GHCR_TOKEN:-}" ] && missing="${missing} GHCR_TOKEN"
    if [ -n "$missing" ]; then
        echo "Error: the following environment variable(s) must be set:${missing}"
        exit 1
    fi
    echo "$GHCR_TOKEN" | container registry login ghcr.io --username "$GHCR_NAME" --password-stdin

# Tag image for GitHub Container Registry
[group('ghcr')]
image-tag: _ghcr-check _system-ensure
    container image tag {{image}} {{ghcr_image}}:{{tag}}

# Push image to GitHub Container Registry
[group('ghcr')]
image-push: _ghcr-check _system-ensure
    container image push {{ghcr_image}}:{{tag}}

# Pull pre-built image from GHCR
[group('ghcr')]
image-pull: _ghcr-check _system-ensure
    container image pull {{ghcr_image}}:{{tag}}

# Build, tag, and push to GHCR
[group('ghcr')]
image-release: image-build image-tag image-push

# --- Run ---

# Run an interactive shell with current directory mounted (e.g., just run --env FOO=bar)
[group('run')]
run *args: _system-ensure
    container run {{run_flags}} \
      {{gh_token_flag}} \
      {{args}} \
      --volume {{invocation_directory()}}:{{mount}} \
      --workdir {{mount}} \
      {{image}} /bin/bash

# Run with GH_TOKEN auto-pulled from `secret`, update Copilot CLI, then launch Copilot in YOLO mode
[group('run')]
run-copilot *args: _system-ensure
    #!/usr/bin/env bash
    set -euo pipefail
    GH_TOKEN="$(just --justfile {{secret_justfile}} get)"
    export GH_TOKEN
    container run {{run_flags}} \
      --env GH_TOKEN \
      {{args}} \
      --volume {{invocation_directory()}}:{{mount}} \
      --workdir {{mount}} \
      {{image}} /bin/bash -lc 'copilot update || echo "warning: copilot update failed, continuing"; copilot --allow-all-tools; exec /bin/bash'

# Run the GHCR image with current directory mounted
[group('run')]
run-ghcr: _ghcr-check _system-ensure
    container run {{run_flags}} \
      {{gh_token_flag}} \
      --volume {{invocation_directory()}}:{{mount}} \
      --workdir {{mount}} \
      {{ghcr_image}}:{{tag}} /bin/bash

# Run with a project directory mounted (e.g., just run-project ~/myproject -- --env FOO=bar)
[group('run')]
run-project project *args: _system-ensure
    container run {{run_flags}} \
      {{gh_token_flag}} \
      --volume {{project}}:{{project_mount}} \
      --workdir {{project_mount}} \
      {{args}} \
      {{image}} /bin/bash

# --- Named Containers ---

# Create a named persistent sandbox (e.g., just create-named my-sandbox ~/projects)
[group('named')]
create-named container_name project: _system-ensure
    container run -d --name {{container_name}} \
      --cpus {{cpus}} \
      --memory {{memory}} \
      {{gh_token_flag}} \
      --volume {{project}}:{{project_mount}} \
      {{image}} /bin/bash -c "sleep infinity"

# Attach to a named sandbox (e.g., just attach my-sandbox)
[group('named')]
attach container_name: _system-ensure
    container exec -it {{container_name}} /bin/bash

# Start a stopped named sandbox
[group('named')]
start container_name: _system-ensure
    container start {{container_name}}

# Stop a named sandbox
[group('named')]
stop container_name: _system-ensure
    container stop {{container_name}}

# Delete a named sandbox (stops first if running)
[group('named')]
delete container_name: _system-ensure
    -container stop {{container_name}}
    container delete {{container_name}}

# List all containers
[group('named')]
list: _system-ensure
    container list --all

# --- Tailscale ---

# Run with Tailscale in userspace mode, SSH enabled (set TS_AUTHKEY for non-interactive login)
[group('tailscale')]
run-tailscale: _system-ensure
    mkdir -p {{ts_state}}
    container run {{run_flags}} \
      {{gh_token_flag}} \
      {{ts_authkey_env}} \
      --volume {{invocation_directory()}}:{{mount}} \
      --volume {{ts_state}}:/home/agent/.tailscale \
      {{image}} /bin/bash -c '\
        sudo tailscaled --tun=userspace-networking --statedir=/home/agent/.tailscale --socket=/tmp/tailscaled.sock --socks5-server=localhost:1055 &\
        sleep 2 && \
        sudo tailscale --socket=/tmp/tailscaled.sock up --ssh {{ts_authkey_flag}} && \
        echo "alias tailscale=\"sudo tailscale --socket=/tmp/tailscaled.sock\"" >> ~/.bashrc && \
        exec /bin/bash'

# Install and start Tailscale with SSH inside this sandbox (run from within the container)
[group('tailscale')]
tailscale-up:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v tailscaled &>/dev/null; then
        echo "Installing Tailscale..."
        curl -fsSL https://tailscale.com/install.sh | sudo sh -s -- --quiet
    fi
    echo "Starting tailscaled..."
    sudo tailscaled --tun=userspace-networking --socket=/tmp/tailscaled.sock --socks5-server=localhost:1055 &>/dev/null &
    sleep 2
    echo "Bringing Tailscale up with SSH..."
    sudo tailscale --socket=/tmp/tailscaled.sock up --ssh
    echo 'alias tailscale="sudo tailscale --socket=/tmp/tailscaled.sock"' >> ~/.bashrc
    echo "Done. You can now SSH in via: tailscale ssh agent@$(sudo tailscale --socket=/tmp/tailscaled.sock status --json 2>/dev/null | grep -o '"DNSName":"[^"]*' | head -1 | cut -d'"' -f4)"

# Check Tailscale status (run from within the container)
[group('tailscale')]
tailscale-status:
    sudo tailscale --socket=/tmp/tailscaled.sock status
