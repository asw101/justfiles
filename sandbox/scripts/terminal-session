#!/usr/bin/env python3
import os
import signal
import subprocess
import sys
import termios


# Disable mouse, focus and paste reporting, show the cursor, and leave the
# alternate screen without clearing scrollback.
RESTORE_MODES = (
    b"\x1b[?9l\x1b[?1000l\x1b[?1001l\x1b[?1002l\x1b[?1003l"
    b"\x1b[?1005l\x1b[?1006l\x1b[?1015l\x1b[?1016l"
    b"\x1b[?1004l\x1b[?2004l\x1b[?25h\x1b[?1049l"
)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: terminal-session COMMAND [ARG...]")

    if not sys.stdin.isatty():
        os.execvp(sys.argv[1], sys.argv[1:])

    with open("/dev/tty", "wb", buffering=0) as terminal:
        settings = termios.tcgetattr(terminal)
        try:
            with subprocess.Popen(sys.argv[1:]) as child:
                def forward_signal(signum, frame):
                    child.send_signal(signum)

                handlers = {}
                try:
                    for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
                        handlers[signum] = signal.signal(signum, forward_signal)
                    status = child.wait()
                finally:
                    for signum, handler in handlers.items():
                        signal.signal(signum, handler)
        finally:
            try:
                terminal.write(RESTORE_MODES)
            finally:
                termios.tcsetattr(terminal, termios.TCSANOW, settings)

    return status if status >= 0 else 128 - status


if __name__ == "__main__":
    sys.exit(main())
