#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 2 ]; then
  echo "usage: dtach-session SOCKET COMMAND [ARG...]" >&2
  exit 2
fi

socket="$1"
shift

cleanup_terminal() {
  if [ -t 0 ] && [ -w /dev/tty ]; then
    stty sane </dev/tty >/dev/tty 2>/dev/null || true
    printf '\033[?1000l\033[?1002l\033[?1003l\033[?1005l\033[?1006l\033[?1015l\033[?1004l\033[?2004l\033[?25h\033[?1049l' >/dev/tty
  fi
}

trap cleanup_terminal EXIT
dtach -A "$socket" -z -r winch "$@"
